# Standard Flutter/Dart build & tooling output — applies to shared/,
# warehouse_app/, and customer_app/ alike.
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
*.iml
*.g.dart
*.freezed.dart

# Platform folders generated by `flutter create .` — not checked in
# until an app actually needs native customization, since they're
# fully regenerable from pubspec.yaml.
android/
ios/
linux/
macos/
windows/
web/

# Local override of the API base URL / other per-developer config.
.env.local
