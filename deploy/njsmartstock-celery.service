[Unit]
Description=NJSmartStock Celery worker
After=network.target postgresql.service redis-server.service
Wants=postgresql.service redis-server.service

[Service]
User=njsmartstock
Group=njsmartstock
WorkingDirectory=/opt/njsmartstock
Environment=DJANGO_SETTINGS_MODULE=stocksense.settings.prod
ExecStart=/opt/njsmartstock/venv/bin/celery -A stocksense worker -l info --concurrency=1
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
